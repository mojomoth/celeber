# CELEBER PoC 환경변수 (루트 .env 하나를 모든 앱이 읽는다: next.config.ts에서 @next/env loadEnvConfig)
# 모든 키는 서버 전용이다. NEXT_PUBLIC_ 접두사를 붙이지 말 것.
# 키가 없으면 해당 기능은 결정적 Mock 데이터로 동작하고 화면에 "데모 데이터" 배지가 표시된다.

# --- Anthropic (비전 분석 / 리포트 서술 생성) ---------------------------------
# 둘 중 하나만 있으면 된다. ANTHROPIC_API_KEY가 우선이며, CLAUDE_API_KEY는 별칭으로 허용.
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=
# 비전/구조화 출력에 사용할 모델 (기본값: claude-opus-5-5)
CELEBER_VISION_MODEL=claude-opus-5-5
# 추론 강도 low | medium | high | xhigh | max (기본값: medium). OpenAI에도 같은 값을 쓴다
CELEBER_VISION_EFFORT=medium

# --- OpenAI (대체 AI 공급자) -----------------------------------------------------
# Anthropic 호출이 실패하거나 사용 한도에 걸리면 같은 프롬프트·스키마로 OpenAI를 부른다. 둘 다 안 되면 Mock.
OPENAI_API_KEY=
# 비전/구조화 출력 모델 (기본값: gpt-6.2-sol, 더 꼼꼼하지만 느린 쪽은 gpt-6.2-astra)
CELEBER_OPENAI_MODEL=
# 공급자 선택: auto(기본, Anthropic → OpenAI) | anthropic | openai
CELEBER_AI_PROVIDER=

# --- 이미지 검색 ---------------------------------------------------------------
# SerpAPI: Google Lens 역이미지 검색 + Google Images 검색 (선택)
SERPAPI_API_KEY=
# 네이버 검색 API: 이미지 검색 (선택, 한국 연예인 검색에 우선 사용)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Google Lens는 공개 URL만 받는다. 로컬 업로드 이미지를 역검색하려면
# 외부에서 접근 가능한 주소(예: 터널 URL)를 지정한다. 비우면 업로드 이미지 역검색은 비활성.
# Lens에는 앱 전체가 아니라 서명·10분 만료가 붙은 이미지 한 장 경로(/api/public-image/<id>?exp&sig)만 넘긴다.
CELEBER_PUBLIC_BASE_URL=
# 공개 이미지 URL 서명 비밀값 (비우면 CELEBER_ACCESS_TOKEN, 그것도 없으면 프로세스마다 임의값)
CELEBER_PUBLIC_IMAGE_SECRET=

# --- 접근 제어 (터널·다른 기기) ---------------------------------------------------
# 모든 앱은 localhost(127.0.0.1, ::1) 요청만 기본 허용한다(proxy.ts). 터널 주소나 LAN IP로 열려면
# 토큰을 정하고, 브라우저에서 한 번 <주소>?access=<토큰> 으로 열면 12시간 쿠키가 설정된다.
# (헤더 x-celeber-access: <토큰> 도 가능) 비우면 localhost 외 접근은 모두 403.
CELEBER_ACCESS_TOKEN=
# 토큰 없이 허용할 추가 호스트 이름(쉼표 구분, 예: 192.168.0.10). 신뢰하는 네트워크에서만.
CELEBER_ALLOWED_HOSTS=

# --- 로컬 데이터 ---------------------------------------------------------------
# SQLite DB와 업로드 파일 위치. 비우면 <앱 폴더>/../.data (= pocs/.data)
CELEBER_DATA_DIR=

# --- 개발용 --------------------------------------------------------------------
# 1이면 키가 있어도 모든 외부 API를 Mock으로 강제 (오프라인/비용 없는 테스트)
CELEBER_FORCE_MOCK=

# --- 허브(포트 3100) -----------------------------------------------------------
# 허브가 각 앱의 /api/health를 확인할 호스트 (기본 127.0.0.1)
CELEBER_HUB_PROBE_HOST=
